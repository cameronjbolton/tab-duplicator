{
  "manifest_version": 3,
  "name": "Tab Duplicator",
  "version": "1.0.0",
  "description": "Duplicate the current tab with Alt+Shift+D",
  "permissions": [
    "tabs"
  ],
  "commands": {
    "duplicate-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "windows": "Alt+Shift+D",
        "mac": "Alt+Shift+D",
        "chromeos": "Alt+Shift+D",
        "linux": "Alt+Shift+D"
      },
      "description": "Duplicate the current tab"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
